# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cryptorisk_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-at-least-32-random-chars
JWT_REFRESH_SECRET=replace-with-different-32-random-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ─── CoinGecko ────────────────────────────────────────────────────────────────
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# ─── Risk calculation ─────────────────────────────────────────────────────────
RISK_FREE_RATE=0.05

# ─── Admin seed (used only by: node prisma/seed.js) ──────────────────────────
# Set this to the admin account password before running the seed script.
# Never commit the real value to git.
ADMIN_SEED_PASSWORD=
